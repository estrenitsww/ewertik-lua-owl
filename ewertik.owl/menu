-- Animaciones
local function OpenMenu()
    Main.Visible = true
    FloatingBtn.Visible = false
    Main.Size = UDim2.new(0, 0, 0, 0)
    TweenService:Create(Main, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0, 460, 0, 320)}):Play()
end

local function CloseMenu()
    TweenService:Create(Main, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = UDim2.new(0, 0, 0, 0)}):Play()
    task.wait(0.2)
    Main.Visible = false
    FloatingBtn.Visible = true
end

FloatingBtn.MouseButton1Click:Connect(OpenMenu)
